# Nuvio web — backend configuration
#
# Copy to `.env` and fill in. The web build talks to the SAME Supabase
# project as the Android app, so one Nuvio account works on both and the
# add-on list saved on the phone is restored in the browser.
#
# These values mirror the Android `local.properties` entries:
#   NUVIO_SUPABASE_URL       -> VITE_SUPABASE_URL
#   NUVIO_SUPABASE_ANON_KEY  -> VITE_SUPABASE_ANON_KEY
#   NUVIO_SUPABASE_FALLBACK_URL -> VITE_SUPABASE_FALLBACK_URL
#
# The publishable ("anon") key is designed to be public — it ships inside the
# Android APK — so it is safe to bake into the web bundle. NEVER put the
# Supabase *secret* key here: it would be readable by every visitor.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable / anon key (starts with "sb_publishable_" or is the
# legacy "anon" JWT). Find it in Supabase -> Project Settings -> API.
VITE_SUPABASE_ANON_KEY=

# Optional alternate origin used when the primary host is unreachable.
VITE_SUPABASE_FALLBACK_URL=

# Where the membership is purchased.
VITE_SUPPORT_URL=https://nuvio.tv/support

# Optional JioTV relay. When set, /jiotv tries the relay first and falls back
# to the browser pipeline. The web app is HTTPS, so use an HTTPS relay URL
# (Cloudflare Tunnel) or http://localhost:8787 for a local test.
VITE_JIOTV_RELAY_URL=

# Optional VZY live stream relay. When set, live channels
# try the relay first (e.g. http://localhost:8090) and fall back to browser playback.
VITE_VZY_RELAY_URL=
