{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "android-tv-expo-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // The NetMirror bridge publishes its current tunnel URL here. The Worker
  // reads it at request time, so a tunnel restart needs no redeploy.
  "kv_namespaces": [
    {
      "binding": "NETMIRROR_KV",
      "id": "5bb751f6e37a44708b975a63534ca41c"
    }
  ]
}
